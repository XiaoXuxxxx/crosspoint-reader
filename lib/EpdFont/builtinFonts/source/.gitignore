# Ignore all font directories except those committed to the repo.
# Fonts like NotoSansCJK are downloaded on demand by build-sd-fonts.py.
*
!.gitignore
!NotoSerif/
!NotoSerif/**
!NotoSans/
!NotoSans/**
!NotoSansHebrew/
!NotoSansHebrew/**
!NotoSansThai/
!NotoSansThai/**
!NotoSerifThai/
!NotoSerifThai/**
!OpenDyslexic/
!OpenDyslexic/**
!Ubuntu/
!Ubuntu/**
